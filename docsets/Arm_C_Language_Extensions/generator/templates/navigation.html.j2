<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ eyebrow }}: {{ title }}">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="../assets/style.css">
</head>
<body>
  <main class="page">
    <a name="{{ anchor }}" class="dashAnchor"></a>
    <header class="hero">
      <div class="eyebrow">{{ eyebrow }}</div>
      <h1>{{ title }}</h1>
      {% if parent %}<p><a href="{{ parent.href }}">← {{ parent.label }}</a></p>{% endif %}
    </header>

    {% if children %}
    <section aria-labelledby="children-heading">
      <h2 id="children-heading">Subcategories</h2>
      <ul class="guide-list">{% for child in children %}<li><a href="{{ child.href }}">{{ child.label }}</a><span class="muted"> — {{ child.count }} callables in this branch</span><div class="guide-path">{{ child.path }}</div></li>{% endfor %}</ul>
    </section>
    {% endif %}

    {% if types %}
    <section aria-labelledby="types-heading">
      <h2 id="types-heading">Documented data types</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Type</th><th>Derived width</th></tr></thead>
          <tbody>{% for item in types %}<tr><td><a href="{{ item.href }}"><code>{{ item.name }}</code></a></td><td>{{ item.summary }}</td></tr>{% endfor %}</tbody>
        </table>
      </div>
    </section>
    {% endif %}

    <section aria-labelledby="callables-heading">
      <h2 id="callables-heading">Direct callables</h2>
      {% if items %}
      <div class="table-scroll">
        <table>
          <thead><tr><th>Kind</th><th>Callable</th><th>Exact signature</th></tr></thead>
          <tbody>{% for item in items %}<tr><td>{{ item.kind }}</td><td><a href="{{ item.href }}"><code>{{ item.name }}</code></a></td><td><code>{{ item.signature }}</code></td></tr>{% endfor %}</tbody>
        </table>
      </div>
      {% else %}
      <p class="missing-value">{{ empty_message }}</p>
      {% endif %}
    </section>
  </main>
</body>
</html>
